{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "scene_traj",
  "type": "object",
  "required": ["format", "scene", "agents"],
  "properties": {
    "format": {"const": "scene_traj"},
    "version": {"type": "integer"},
    "cell_size": {"type": "number", "exclusiveMinimum": 0},
    "angle_units": {"enum": ["rad", "deg"]},
    "scene": {
      "type": "object",
      "required": ["objects"],
      "properties": {
        "objects": {"type": "array"}
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "trajectory"],
        "properties": {
          "name": {"type": "string"},
          "color": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
          "radius": {"type": "number"},
          "body": {"enum": ["ball", "plane"]},
          "trajectory": {"type": "array"}
        }
      }
    }
  }
}
